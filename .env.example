# Inner Animal — environment
# Static-first launch needs none of these (the app runs with zero config).
# These are for Phase 7 (accounts + saved results):

# PORT is provided by Railway automatically.
# APP_URL=https://www.inneranimalquiz.com
# NODE_ENV=production

# Email sign-in (6-digit code) via Resend — Phase 7
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Inner Animal <hello@inneranimalquiz.com>

# SQLite lives on a Railway volume mounted at /data — Phase 7
# DATABASE_PATH=/data/inner-animal.sqlite
